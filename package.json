{
  "name": "sodmin",
  "version": "0.3.0",
  "description": "Cokret administrator web UI (Playwright e2e harness).",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "npx playwright test -c tests/e2e/playwright.config.ts",
    "test:ui": "npx playwright test -c tests/e2e/playwright.config.ts --ui",
    "test:headed": "npx playwright test -c tests/e2e/playwright.config.ts --headed",
    "test:debug": "npx playwright test -c tests/e2e/playwright.config.ts --debug",
    "test:report": "npx playwright show-report",
    "test:a11y": "npx playwright test -c tests/e2e/playwright.config.ts tests/e2e/a11y.spec.ts",
    "test:keyboard": "npx playwright test -c tests/e2e/playwright.config.ts tests/e2e/keyboard-strands.spec.ts",
    "test:rtl": "npx playwright test -c tests/e2e/playwright.config.ts tests/e2e/rtl.spec.ts",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "test:round26": "npx playwright test -c tests/e2e/playwright.config.ts",
    "test:round26:headed": "npx playwright test -c tests/e2e/playwright.config.ts --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cokret/sodmin.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cokret/sodmin/issues"
  },
  "homepage": "https://github.com/cokret/sodmin#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "pg": "^8.22.0"
  }
}
