{
  "name": "sodmin",
  "version": "1.0.0",
  "description": "Contrix administrator web UI (Playwright e2e harness).",
  "main": "index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "npm run test:app",
    "test:app": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:report": "npx playwright show-report",
    "test:example-stack": "npx playwright test -c playwright.example-stack.config.ts",
    "test:example-stack:headed": "npx playwright test -c playwright.example-stack.config.ts --headed",
    "test:example-stack:debug": "npx playwright test -c playwright.example-stack.config.ts --debug",
    "test:example-stack:report": "npx playwright show-report playwright-report/example-stack",
    "test:example-stack:fresh": "npm run stack:reset && npm run test:example-stack",
    "stack:reset": "node e2e/scripts/reset-example-stack.mjs",
    "stack:up": "node e2e/scripts/reset-example-stack.mjs up",
    "stack:down": "node e2e/scripts/reset-example-stack.mjs down",
    "test:round26": "npx playwright test -c tests/e2e/playwright.config.ts",
    "test:round26:headed": "npx playwright test -c tests/e2e/playwright.config.ts --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contrix-dev/sodmin.git"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/contrix-dev/sodmin/issues"
  },
  "homepage": "https://github.com/contrix-dev/sodmin#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "pg": "^8.20.0"
  }
}
